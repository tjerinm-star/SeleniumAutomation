<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Testing" parallel="methods">

	<test thread-count="5" name="Test1">
		<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="testscripts.HomeTest">
				<methods>
					<include name="verifyUserIsAbleToSuccessfullyLogout"></include>
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->

	<test thread-count="5" name="Test2">
		<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="testscripts.LoginTest">
				<methods>
					<include
						name="verifyUserLoginWithInvalidUsernameAndValidPassword"></include>
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->


</suite> <!--
Suite -->